[gd_scene format=3]

[ext_resource type="Script" path="res://ui/sound_center.gd" id="1_center"]
[ext_resource type="PackedScene" path="res://space/sky.tscn" id="2_stars"]
[ext_resource type="Script" path="res://ui/hud_panel.gd" id="3_panel"]
[ext_resource type="Script" path="res://ui/sound_button.gd" id="4_sound"]

[node name="SoundCenter" type="Node2D"]
script = ExtResource("1_center")

[node name="Sky" parent="." instance=ExtResource("2_stars")]

[node name="Camera" type="Camera2D" parent="."]
position = Vector2(640, 360)

[node name="UI" type="CanvasLayer" parent="."]

[node name="SoundButton" type="Button" parent="UI"]
anchor_left = 1.0
anchor_right = 1.0
offset_left = -50.0
offset_top = 14.0
offset_right = -18.0
offset_bottom = 44.0
grow_horizontal = 0
focus_mode = 0
theme_override_constants/icon_max_width = 16
icon_alignment = 1
script = ExtResource("4_sound")

[node name="Center" type="CenterContainer" parent="UI"]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="UI/Center"]
layout_mode = 2
script = ExtResource("3_panel")

[node name="Margin" type="MarginContainer" parent="UI/Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 18

[node name="VBox" type="VBoxContainer" parent="UI/Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="UI/Center/Panel/Margin/VBox"]
layout_mode = 2

[node name="Title" type="Label" parent="UI/Center/Panel/Margin/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HudTitle"
theme_override_font_sizes/font_size = 26
text = "Centrum zvuků"
uppercase = true

[node name="BackButton" type="Button" parent="UI/Center/Panel/Margin/VBox/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 34)
layout_mode = 2
focus_mode = 0
text = "Zpět do zápisníku"

[node name="Columns" type="HBoxContainer" parent="UI/Center/Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 20

[node name="Player" type="HBoxContainer" parent="UI/Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="PreviousButton" type="Button" parent="UI/Center/Panel/Margin/VBox/Player"]
unique_name_in_owner = true
custom_minimum_size = Vector2(110, 36)
layout_mode = 2
focus_mode = 0
text = "Předchozí"
metadata/silent_click = true

[node name="ReplayButton" type="Button" parent="UI/Center/Panel/Margin/VBox/Player"]
unique_name_in_owner = true
custom_minimum_size = Vector2(110, 36)
layout_mode = 2
focus_mode = 0
text = "Znovu"
metadata/silent_click = true

[node name="NextButton" type="Button" parent="UI/Center/Panel/Margin/VBox/Player"]
unique_name_in_owner = true
custom_minimum_size = Vector2(130, 36)
layout_mode = 2
focus_mode = 0
theme_type_variation = &"PrimaryButton"
text = "Další"
metadata/silent_click = true

[node name="NowPlaying" type="Label" parent="UI/Center/Panel/Margin/VBox/Player"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HudDim"
text = "Vyber zvuk"
horizontal_alignment = 2
