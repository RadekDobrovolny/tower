[gd_resource type="Resource" script_class="Mission" format=3]

[ext_resource type="Script" path="res://missions/mission.gd" id="1_mission"]

[resource]
script = ExtResource("1_mission")
title = "Zábava pro zákazníky"
description = "Lodí přibývá a fronty se prodlužují. Klikni na prázdnou parcelu a postav zákazníkům zábavní systém, ať jim čekání rychleji utíká. Pumpík zvládne obsluhovat dva sloty najednou, druhý čerpací slot si můžeš postavit taky."
max_android_level = 6
entertainment_available = true
max_slots = 2
ship_interval_min = 2.0
ship_interval_max = 5.0
goal_entertainment_level = 3
start_credits = 2000
start_fuel_level = 3
start_walk_level = 3
