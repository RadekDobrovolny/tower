[gd_resource type="Resource" script_class="Mission" format=3]

[ext_resource type="Script" path="res://missions/mission.gd" id="1_mission"]

[resource]
script = ExtResource("1_mission")
title = "Vlastní galaxín"
description = "Dosavadní dodavatel s tebou končí. Od teď si galaxín objednáváš sám a sám určuješ jeho cenu. Do zásobníku dostáváš první várku 300 j zdarma. Pozor na levné dodavatele, za nekvalitní galaxín hrozí pokuty."
max_android_level = 6
entertainment_available = true
max_slots = 2
galaxin_economy = true
start_galaxin = 300
ship_interval_min = 2.0
ship_interval_max = 5.0
goal_credits = 15000
goal_tank_level = 3
start_credits = 3000
start_fuel_level = 6
start_walk_level = 5
start_entertainment_level = 3
start_slots = 2
